  faction: 1
  chatMessages:
  - sender: 1
    messageContent: Judge, ignorance is not stability, it is regression
  - sender: 1
    messageContent: If even we forget what humanity used to be, what is the difference
      between us and beasts?
  - sender: 1
    messageContent: He must be found not guilty, and that knowledge must be protected
  - sender: 1
    messageContent: This is your duty as a Judge of the Ministry of Truth
  requirement:
    requiredChoiceIndices: 0100000001000000
  evaluationSuccessMessages:
  - sender: 1
    messageContent: You protected the spark of civilization
  - sender: 1
    messageContent: History will remember your contribution
  evaluationFailureMessages:
  - sender: 1
    messageContent: You yielded to the intimidation of the Ministry of Peace
  - sender: 1
    messageContent: Truly a disgrace to the Ministry of Truth, you burned the future
