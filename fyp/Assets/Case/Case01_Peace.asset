  m_Script: {fileID: 11500000, guid: f3a1c301f26bc184fbc2430d0c1f706c, type: 3}
  m_Name: Case01_Peace
  m_EditorClassIdentifier: Assembly-CSharp::FactionStoryline
  faction: 3
  chatMessages:
  - sender: 3
    messageContent: Judge. The Energy Tower is humanity's only barrier.
  - sender: 3
    messageContent: Any threat to it is tantamount to murdering everyone.
  - sender: 3
    messageContent: Motive? Motive is irrelevant.
  - sender: 3
    messageContent: She must be found guilty and classified as a public hazard.
  - sender: 3
    messageContent: As for the punishment.
  - sender: 3
    messageContent: Exile is the only answer, we need a deterrent.
  requirement:
    requiredChoiceIndices: 000000000100000001000000
  evaluationSuccessMessages:
  - sender: 3
    messageContent: That's the way!
  - sender: 3
    messageContent: No one can threaten the Energy Tower.
  evaluationFailureMessages:
  - sender: 3
    messageContent: Your verdict is too weak!
  - sender: 3
    messageContent: Keeping this kind of person in the Tower will only be the next
      threat!
