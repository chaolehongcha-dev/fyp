  m_Script: {fileID: 11500000, guid: f3a1c301f26bc184fbc2430d0c1f706c, type: 3}
  m_Name: Case01_Love
  m_EditorClassIdentifier: 
  faction: 2
  chatMessages:
  - sender: 2
    messageContent: 'Your Honor! We have investigated!

'
  - sender: 2
    messageContent: Alice just wanted to start the old air filter in District 7!
  - sender: 2
    messageContent: Her son suffers from severe lung disease.
  - sender: 2
    messageContent: The Ministry of Order refused to provide him with the rare filtration
      device...
  - sender: 2
    messageContent: She did make a mistake, you can find her guilty.
  - sender: 2
    messageContent: But you must understand that her motives are justifiable.
  - sender: 2
    messageContent: Finally, please release her, a child cannot be without a mother.
  requirement:
    requiredChoiceIndices: 0000000000000000
  evaluationSuccessMessages:
  - sender: 2
    messageContent: Thank you... thank you for seeing the humanity behind the law
  - sender: 2
    messageContent: You saved a family.
  evaluationFailureMessages:
  - sender: 2
    messageContent: A cold verdict... the machines of the Ministry of Order won again.
  - sender: 2
    messageContent: We are disappointed in you.
