  - image: {fileID: 21300000, guid: af447d10437784043ac5a35dfe9cf65d, type: 3}
    subtitle: First came the cold. Then, the war... until the old world was buried
      beneath the ice
    voiceOver: {fileID: 8300000, guid: e15d052864eed2f4997d2a6106a5cfb4, type: 3}
    stopPreviousVoice: 1
    sfx: {fileID: 0}
    autoAdvance: 0
